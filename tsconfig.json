{
  "compilerOptions": {
    "module": "es6",
    "moduleResolution": "bundler",
    "target": "es6",
    "lib": ["dom", "ESNext"],
    "strict": true,
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest*.config.ts", "playwright*.config.ts"],
  "exclude": ["dist", "node_modules"]
}
